{
  "name": "personal-portfolio-blog",
  "version": "1.0.0",
  "description": "Production-ready personal blog, career showcase, and software version tracker with PM2 support",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "cd client && npm install",
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "npm run build && node server/index.js",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs personal-space",
    "pm2:status": "npx pm2 status"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pm2": "^7.0.4"
  }
}
